# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Production only: configure a header your hosting proxy overwrites with the client IP.
# Do not use a header that callers can set directly.
CYBERSAFE_TRUSTED_CLIENT_IP_HEADER="your-proxy-overwritten-client-ip-header"
